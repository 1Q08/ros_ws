<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- ============ polygon_base 包清单 ============ -->
<!-- format="3" 表示采用 ROS 包格式 3 -->
<package format="3">
  <!-- 包名：必须与目录名、CMakeLists.txt 里的 project() 保持一致 -->
  <name>polygon_base</name>
  <!-- 版本号 -->
  <version>1.0.0</version>
  <!-- 包的功能说明 -->
  <description>基础包</description>
  <!-- 维护者（含邮箱），ros2 pkg 等工具会用到 -->
  <maintainer email="example@163.com">nvidia</maintainer>
  <!-- 许可证 -->
  <license>Apache-2.0</license>

  <!-- 构建工具依赖：ament_cmake 构建系统 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 编译/运行依赖：基类头文件用到 pluginlib 的类型 -->
  <depend>pluginlib</depend>

  <!-- 测试依赖：ament 自带的静态检查工具 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <!-- 声明本包使用 ament_cmake 构建类型 -->
    <build_type>ament_cmake</build_type>
  </export>
</package>
