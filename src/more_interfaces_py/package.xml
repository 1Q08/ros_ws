<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<?xml-model href="http://download.ros.org/schema/package_format2.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  package.xml —— ROS2 包清单文件(方案:ament_cmake 包 + Python 库/节点)
  关键点:本包使用 ament_cmake 构建(为了生成 .msg 接口),
         但同时通过 ament_cmake_python 扩展把 Python 库模块
         安装进 site-packages,实现"节点为 Python"。
  注意:ament_cmake_python 不是构建类型(build_type 仍是 ament_cmake),
       而是一个"CMake 扩展包",所以这里用 <buildtool_depend> 声明它。
-->
<package format="3">
  <name>more_interfaces_py</name>                       <!-- 包名(全局唯一) -->
  <version>1.0.0</version>
  <description>在 ament_cmake 包中同时定义 .msg 接口与 Python 节点(使用 ament_cmake_python)</description>
  <maintainer email="19872205914@163.com">nvidia</maintainer> <!-- 维护者 -->
  <license>Apache-2.0</license>                         <!-- 开源许可证 -->

  <!-- 构建工具依赖:ament_cmake 提供 CMake 集成(rosidl 需要它) -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- 构建工具依赖:ament_cmake_python 扩展,提供 ament_python_install_package()
       命令,把 Python 库安装进 site-packages(见 CMakeLists.txt) -->
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <!-- 构建工具依赖:rosidl 接口代码生成器(把 .msg 生成代码) -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- 运行期依赖:运行 rosidl 生成的接口所需的运行时库 -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <!-- 运行期依赖:rclpy —— Python 节点的客户端库 -->
  <exec_depend>rclpy</exec_depend>

  <!-- 关键声明:本包属于 "接口包" 分组,
       让其他包能够发现并使用本包定义的接口 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- 测试依赖(代码风格/静态检查) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <!-- 构建类型:使用 ament_cmake 方式构建(为了生成 .msg 接口) -->
    <build_type>ament_cmake</build_type>
  </export>
</package>