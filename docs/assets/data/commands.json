          "example": "ros2 service call /add_two_ints example_interfaces/srv/AddTwoInts \"{a: 1, b: 2}\"",
          "options": [],
          "notes": ""
        },
        {
          "display": "echo",
          "title": "ros2 service echo",
          "cmd": "ros2 service echo <service_name> [service_type]",
          "desc": "回显服务请求数据（服务内省），持续监听并打印发送到该服务的请求数据，按 Ctrl+C 停止",
          "example": "ros2 service echo /add_two_ints example_interfaces/srv/AddTwoInts",
          "options": [
