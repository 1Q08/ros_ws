{
  "ros1": {
    "core": {
      "name": "核心命令",
      "commands": [
        {
          "display": "roscore",
          "title": "roscore",
          "cmd": "roscore",
          "desc": "启动 ROS Master 和参数服务器",
          "example": "roscore",
          "options": [],
          "notes": "必须在运行任何 ROS 节点之前启动"
        },
        {
          "display": "rosrun",
          "title": "rosrun",
          "cmd": "rosrun <package> <node>",
          "desc": "运行指定包中的节点,",
          "example": "rosrun turtlesim turtlesim_node",
          "options": [],
          "notes": ""
        },
        {
          "display": "roslaunch",
          "title": "roslaunch",
          "cmd": "roslaunch <package> <launch_file>",
          "desc": "通过 launch 文件启动多个节点，支持参数传递和节点组合",
          "example": "roslaunch my_package my_launch.launch",
          "options": [],
          "notes": "Launch 文件是 XML 格式，定义了节点、参数、话题和服务的启动配置"
        }
      ]
    },
    "topic": {
      "name": "话题命令",
      "commands": [
        {
          "display": "rostopic list",
          "title": "rostopic list",
          "cmd": "rostopic list",
          "desc": "列出当前系统中所有发布/订阅的话题",
          "example": "rostopic list",
          "options": [],
          "notes": "可用 grep 过滤，如 rostopic list | grep chatter"
        },
        {
          "display": "rostopic echo",
          "title": "rostopic echo",
          "cmd": "rostopic echo <topic_name>",
          "desc": "实时打印话题发布的消息内容，按 Ctrl+C 停止显示",
          "example": "rostopic echo /chatter",
          "options": [],
          "notes": ""
        },
        {
          "display": "rostopic pub",
          "title": "rostopic pub",
          "cmd": "rostopic pub <topic_name> <message_type> <message>",
          "desc": "向话题发布消息",
          "example": "rostopic pub /chatter std_msgs/String \"hello\"",
          "options": [
            {
              "flag": "-r <rate>",
              "desc": "以指定频率持续发布消息"
            }
          ],
          "notes": ""
        },
        {
          "display": "rostopic hz",
          "title": "rostopic hz",
          "cmd": "rostopic hz <topic_name>",
          "desc": "显示话题发布频率，用于检查话题是否按预期频率发布",
          "example": "rostopic hz /chatter",
          "options": [],
          "notes": ""
        }
      ]
    },
    "node": {
      "name": "节点命令",
      "commands": [
        {
          "display": "rosnode list",
          "title": "rosnode list",
          "cmd": "rosnode list",
          "desc": "列出所有运行的节点",
          "example": "rosnode list",
          "options": [],
          "notes": "显示当前系统中所有活跃的 ROS 节点"
        },
        {
          "display": "rosnode info",
          "title": "rosnode info",
          "cmd": "rosnode info <node_name>",
          "desc": "显示节点详细信息，包括发布/订阅的话题、服务和参数",
          "example": "rosnode info /talker",
          "options": [],
          "notes": ""
        },
        {
          "display": "rosnode kill",
          "title": "rosnode kill",
          "cmd": "rosnode kill <node_name>",
          "desc": "强制关闭节点",
          "example": "rosnode kill /talker",
          "options": [],
          "notes": "强制关闭节点，可能产生警告"
        }
      ]
    },
    "service": {
      "name": "服务命令",
      "commands": [
        {
          "display": "rosservice list",
          "title": "rosservice list",
          "cmd": "rosservice list",
          "desc": "列出所有可用的服务",
          "example": "rosservice list",
          "options": [],
          "notes": ""
        },
        {
          "display": "rosservice call",
          "title": "rosservice call",
          "cmd": "rosservice call <service> <args>",
          "desc": "调用服务并返回结果，args 为 YAML 格式的参数",
          "example": "rosservice call /add_two_ints \"a: 1, b: 2\"",
          "options": [],
          "notes": "调用服务时，参数需要按照服务定义的格式传递"
        }
      ]
    },
    "param": {
      "name": "参数命令",
      "commands": [
        {
          "display": "rosparam list",
          "title": "rosparam list",
          "cmd": "rosparam list",
          "desc": "列出参数服务器中的所有参数",
          "example": "rosparam list",
          "options": [],
          "notes": ""
        },
        {
          "display": "rosparam set",
          "title": "rosparam set",
          "cmd": "rosparam set <param> <value>",
          "desc": "设置参数值",
          "example": "rosparam set /my_param 10",
          "options": [],
          "notes": ""
        },
        {
          "display": "rosparam get",
          "title": "rosparam get",
          "cmd": "rosparam get <param>",
          "desc": "获取参数值",
          "example": "rosparam get /my_param",
          "options": [],
          "notes": ""
        }
      ]
    },
    "bag": {
      "name": "数据记录",
      "commands": [
        {
          "display": "rosbag record",
          "title": "rosbag record",
          "cmd": "rosbag record <topic_names>",
          "desc": "录制话题数据到 bag 文件",
          "example": "rosbag record -a",
          "options": [
            {
              "flag": "-o <prefix>",
              "desc": "指定输出文件前缀"
            },
            {
              "flag": "-a",
              "desc": "录制所有话题"
            }
          ],
          "notes": ""
        },
        {
          "display": "rosbag play",
          "title": "rosbag play",
          "cmd": "rosbag play <bag_file>",
          "desc": "回放 bag 文件中的数据，支持调整回放速度、循环播放等选项",
          "example": "rosbag play my_data.bag",
          "options": [
            {
              "flag": "-r <rate>",
              "desc": "调整回放速度"
            }
          ],
          "notes": "可用于测试和仿真，回放时会按照原始时间戳发布消息"
        },
        {
          "display": "rosbag info",
          "title": "rosbag info",
          "cmd": "rosbag info",
          "desc": "显示 bag 文件信息，包括时长、话题、消息类型等",
          "example": "rosbag info my_data.bag",
          "options": [],
          "notes": ""
        }
      ]
    }
  },
  "ros2": {
    "core": {
      "name": "核心命令",
      "commands": [
        {
          "display": "ros2 run",
          "title": "ros2 run",
          "cmd": "ros2 run <package_name> <executable_name>",
          "desc": "运行指定包中的节点",
          "example": "ros2 run turtlesim turtlesim_node --ros-args --params-file ~/Desktop/turtlesim.yaml",
          "options": [
            {
              "flag": "--ros-args --params-file <file>",
              "desc": "从 YAML 文件加载参数"
            },
            {
              "flag": "--ros-args -p <param>:=<value>",
              "desc": "直接在命令行设置参数（-p 即 --param）"
            },
            {
              "flag": "--ros-args --log-level <level>",
              "desc": "设置日志级别（debug / info / warn / error / fatal）"
            },
            {
              "flag": "--ros-args --remap <from>:=<to>",
              "desc": "重映射话题/服务名"
            }
          ],
          "notes": ""
        },
        {
          "display": "ros2 launch",
          "title": "ros2 launch",
          "cmd": "ros2 launch <package_name> <launch_file>",
          "desc": "通过 launch 文件启动多个节点",
          "example": "ros2 launch my_package my_launch.py",
          "options": [],
          "notes": ""
        },
        {
          "display": "ros2 doctor",
          "title": "ros2 doctor",
          "cmd": "ros2 doctor",
          "desc": "检查 ROS 2 环境配置是否正常，环境变量、网络、系统等设置，报告潜在问题",
          "example": "ros2 doctor",
          "options": [
            {
              "flag": "--report",
              "desc": "生成完整的诊断报告"
            },
            {
              "flag": "--fail-on-error",
              "desc": "存在错误时以非零状态退出"
            }
          ],
          "notes": ""
        }
      ]
    },
    "pkg": {
      "name": "包管理",
      "commands": [
        {
          "display": "list",
          "title": "ros2 pkg list",
          "cmd": "ros2 pkg list",
          "desc": "列出当前环境中所有可用的包",
          "example": "ros2 pkg list",
          "options": [],
          "notes": "可用 grep 过滤，如 ros2 pkg list | grep turtlesim"
        },
        {
          "display": "prefix",
          "title": "ros2 pkg prefix",
          "cmd": "ros2 pkg prefix <package_name>",
          "desc": "返回包的安装目录，可用于查看包的源码或资源位置",
          "example": "ros2 pkg prefix turtlesim",
          "options": [],
          "notes": ""
        },
        {
          "display": "executables",
          "title": "ros2 pkg executables",
          "cmd": "ros2 pkg executables [package_name]",
          "desc": "列出包内提供的所有可执行文件",
          "example": "ros2 pkg executables turtlesim",
          "options": [],
          "notes": "不带包名时列出所有包的可执行文件，带包名时只列出指定包的"
        },
        {
          "display": "create",
          "title": "ros2 pkg create",
          "cmd": "ros2 pkg create <package_name>",
          "desc": "创建一个新的 ROS 2 功能包",
          "example": "# 创建一个 Python 包（带依赖与节点文件）\nros2 pkg create my_package --build-type ament_python --dependencies std_msgs --node-name my_node\n# 创建一个带许可证、描述与维护者信息的包\nros2 pkg create my_robot_pkg --license Apache-2.0 --description \"My robot description\" --maintainer-email \"you@example.com\" --maintainer-name \"Your Name\"",
          "options": [
            {
              "flag": "--build-type <type>",
              "desc": "指定构建类型（ament_python / ament_cmake / ament_cmake_python）"
            },
            {
              "flag": "--dependencies <deps>",
              "desc": "指定依赖包，如 --dependencies rclpy std_msgs"
            },
            {
              "flag": "--node-name <name>",
              "desc": "同时创建一个节点文件"
            },
            {
              "flag": "--license <license>",
              "desc": "指定许可证，例如 Apache-2.0"
            },
            {
              "flag": "--description <description>",
              "desc": "添加包描述，会写入 package.xml"
            },
            {
              "flag": "--maintainer-email <email>",
              "desc": "设置维护者邮箱"
            },
            {
              "flag": "--maintainer-name <name>",
              "desc": "设置维护者姓名"
            }
          ],
          "notes": ""
        },
        {
          "display": "xml",
          "title": "ros2 pkg xml",
          "cmd": "ros2 pkg xml <package_name>",
          "desc": "输出指定包的 package.xml 内容，可用于查看包的元信息，如依赖、版本、许可证等",
          "example": "ros2 pkg xml turtlesim",
          "options": [],
          "notes": ""
        }
      ]
    },
    "build": {
      "name": "构建命令",
      "commands": [
        {
          "display": "build",
          "title": "colcon build",
          "cmd": "colcon build",
          "desc": "构建工作空间中的所有包（或通过参数指定部分包）",
          "example": "colcon build\n# 只构建指定包\ncolcon build --packages-select my_package\n# 使用符号链接安装，便于开发调试\ncolcon build --symlink-install",
          "options": [
            {
              "flag": "--packages-select <pkg>",
              "desc": "只构建指定的包（可多个，空格分隔）"
            },
            {
              "flag": "--packages-up-to <pkg>",
              "desc": "构建指定包及其所有依赖包"
            },
            {
              "flag": "--symlink-install",
              "desc": "使用符号链接安装，修改代码后无需重新构建"
            },
            {
              "flag": "--cmake-args <args>",
              "desc": "向 CMake 传递额外参数"
            }
          ],
          "notes": "需在已配置环境的工作空间根目录运行；构建前确保已 source 对应 ROS 2 发行版与依赖"
        },
        {
          "display": "list",
          "title": "colcon list",
          "cmd": "colcon list",
          "desc": "列出工作空间中的所有包及其路径",
          "example": "colcon list\ncolcon list --names-only",
          "options": [
            {
              "flag": "--names-only",
              "desc": "只显示包名，不显示路径"
            },
            {
              "flag": "--paths-only",
              "desc": "只显示包所在路径"
            }
          ],
          "notes": ""
        },
        {
          "display": "test",
          "title": "colcon test",
          "cmd": "colcon test",
          "desc": "运行工作空间中所有包（或指定包）的测试",
          "example": "colcon test\ncolcon test --packages-select my_package",
          "options": [
            {
              "flag": "--packages-select <pkg>",
              "desc": "只测试指定的包（可多个，空格分隔）"
            },
            {
              "flag": "--pytest-args <args>",
              "desc": "向 pytest 传递额外参数"
            },
            {
              "flag": "--ctest-args <args>",
              "desc": "向 CTest 传递额外参数"
            }
          ],
          "notes": "运行 colcon test 前需先执行 colcon build"
        },
        {
          "display": "test-result",
          "title": "colcon test-result",
          "cmd": "colcon test-result",
          "desc": "显示上一次 colcon test 的测试结果摘要",
          "example": "colcon test-result\ncolcon test-result --verbose",
          "options": [
            {
              "flag": "--all",
              "desc": "显示所有测试（含通过）"
            },
            {
              "flag": "--verbose",
              "desc": "显示详细输出"
            }
          ],
          "notes": ""
        },
        {
          "display": "graph",
          "title": "colcon graph",
          "cmd": "colcon graph",
          "desc": "以依赖图形式展示工作空间中各包之间的依赖关系",
          "example": "colcon graph\ncolcon graph --dot",
          "options": [
            {
              "flag": "--dot",
              "desc": "生成 Graphviz DOT 格式文件"
            },
            {
              "flag": "--legend",
              "desc": "在图例中显示包类型图例信息"
            }
          ],
          "notes": "可用 colcon graph --dot 生成 .dot 文件，再用 dot -Tpng dependencies.dot -o dependencies.png 渲染为图片"
        }
      ]
    },
    "topic": {
      "name": "话题命令",
      "commands": [
        {
          "display": "-h",
          "title": "ros2 topic -h",
          "cmd": "ros2 topic -h",
          "desc": "查看话题命令的帮助信息",
          "example": "ros2 topic -h",
          "options": [],
          "notes": "显示 ros2 topic 的所有子命令和用法说明，也可用于子命令，如 ros2 topic pub -h"
        },
        {
          "display": "list",
          "title": "ros2 topic list",
          "cmd": "ros2 topic list [options]",
          "desc": "列出当前系统中所有发布/订阅的话题",
          "example": "ros2 topic list",
          "options": [
            {
              "flag": "-t, --show-types",
              "desc": "同时显示话题类型"
            },
            {
              "flag": "-v, --verbose",
              "desc": "显示详细信息（包括 QoS 配置、发布/订阅节点数等）"
            }
          ],
          "notes": "可用 grep 过滤，如 ros2 topic list | grep chatter"
        },
        {
          "display": "echo",
          "title": "ros2 topic echo",
          "cmd": "ros2 topic echo <topic_name>",
          "desc": "实时打印话题发布的消息内容，按 Ctrl+C 停止显示",
          "example": "ros2 topic echo /chatter",
          "options": [],
          "notes": ""
        },
        {
          "display": "info",
          "title": "ros2 topic info",
          "cmd": "ros2 topic info <topic_name>",
          "desc": "显示一个话题的详细信息，包括其消息类型、发布者和订阅者的数量等，按 Ctrl+C 停止显示",
          "example": "ros2 topic info /chatter",
          "options": [
            {
              "flag": "-v, --verbose",
              "desc": "显示详细信息（包括 QoS 配置、发布/订阅节点数等）"
            }
          ],
          "notes": ""
        },
        {
          "display": "pub",
          "title": "ros2 topic pub",
          "cmd": "ros2 topic pub [options] <topic_name> <msg_type> \"<args>\"",
          "desc": "手动向话题发布消息，支持持续发布或只发布一次，消息内容使用 YAML 格式传递，持续发布时按 Ctrl+C 停止",
          "example": "ros2 topic pub /chatter std_msgs/msg/String \"data: hello\"",
          "options": [
            {
              "flag": "--once",
              "desc": "只发布一次消息后退出"
            },
            {
              "flag": "-r 1, --rate 1",
              "desc": "以 1Hz 频率持续发布（默认 1Hz）"
            },
            {
              "flag": "-w N",
              "desc": "等待匹配的订阅者数量达到 N 后再开始发布"
            },
            {
              "flag": "--yaml-file FILE",
              "desc": "从 YAML 文件读取消息内容（如 ros2 topic echo 的 STDOUT 输出）"
            }
          ],
          "notes": "提示：输入话题名和消息类型后按 Tab 可自动补全 YAML 字段模板，直接修改数值后回车发布\n示例：\n  ros2 topic pub /turtle1/cmd_vel geometry_msgs/msg/Twist <TAB>"
        },
        {
          "display": "hz",
          "title": "ros2 topic hz",
          "cmd": "ros2 topic hz <topic_name>",
          "desc": "显示话题发布频率，用于检查话题是否按预期频率发布",
          "example": "ros2 topic hz /chatter",
          "options": [],
          "notes": ""
        },
        {
          "display": "bw",
          "title": "ros2 topic bw",
          "cmd": "ros2 topic bw [options] <topic_name>",
          "desc": "显示话题占用的带宽",
          "example": "ros2 topic bw /chatter",
          "options": [
            {
              "flag": "-w N, --window N",
              "desc": "用于计算速率的最大窗口大小（消息数，默认 100）"
            },
            {
              "flag": "--spin-time SECS",
              "desc": "等待发现节点的秒数"
            }
          ],
          "notes": "带宽反映订阅端的接收速率，可能受平台资源与 QoS 配置影响，未必与发布端带宽完全一致"
        },
        {
          "display": "find",
          "title": "ros2 topic find",
          "cmd": "ros2 topic find [options] <topic_type>",
          "desc": "列出指定消息类型的可用话题",
          "example": "ros2 topic find std_msgs/msg/String",
          "options": [
            {
              "flag": "-c, --count-topics",
              "desc": "只显示匹配到的话题数量"
            }
          ],
          "notes": "按消息类型过滤并输出所有匹配的话题名"
        }
      ]
    },
    "node": {
      "name": "节点命令",
      "commands": [
        {
          "display": "-h",
          "title": "ros2 node -h",
          "cmd": "ros2 node -h",
          "desc": "查看节点命令的帮助信息",
          "example": "ros2 node -h",
          "options": [],
          "notes": "显示 ros2 node 的所有子命令和用法说明，也可用于子命令，如 ros2 node list -h"
        },
        {
          "display": "list",
          "title": "ros2 node list",
          "cmd": "ros2 node list",
          "desc": "列出所有运行的节点",
          "example": "ros2 node list",
          "options": [],
          "notes": ""
        },
        {
          "display": "info",
          "title": "ros2 node info",
          "cmd": "ros2 node info <node_name>",
          "desc": "显示节点详细信息，包括发布/订阅的话题、服务和动作",
          "example": "ros2 node info /talker",
          "options": [],
          "notes": ""
        }
      ]
    },
    "component": {
      "name": "组件命令",
      "commands": [
        {
          "display": "container",
          "title": "ros2 component container",
          "cmd": "ros2 component container <container_name>",
          "desc": "启动一个组件容器节点",
          "example": "ros2 component container /my_container",
          "options": [],
          "notes": "容器节点可在同一进程中运行多个组件，实现节点组合（composition）和零拷贝通信"
        },
        {
          "display": "list",
          "title": "ros2 component list",
          "cmd": "ros2 component list [container_name]",
          "desc": "列出容器节点中的所有组件",
          "example": "ros2 component list",
          "options": [],
          "notes": "可显示指定容器节点中已加载的组件信息，不带容器名时列出所有"
        },
        {
          "display": "types",
          "title": "ros2 component types",
          "cmd": "ros2 component types",
          "desc": "列出可用的组件类型，",
          "example": "ros2 component types",
          "options": [],
          "notes": ""
        },
        {
          "display": "load",
          "title": "ros2 component load",
          "cmd": "ros2 component load <container_name> <package_name> <component_type>",
          "desc": "将组件加载到容器节点",
          "example": "ros2 component load /my_container composition composition::Talker",
          "options": [
            {
              "flag": "--node-name <name>",
              "desc": "指定组件节点名称"
            },
            {
              "flag": "--remap <from>:=<to>",
              "desc": "重映射话题/服务名"
            }
          ],
          "notes": "组件类型可通过 ros2 component types 查看，加载后组件会在容器节点中运行"
        },
        {
          "display": "unload",
