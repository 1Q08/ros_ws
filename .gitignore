# ============================================================
# ROS 1 (catkin) 构建产物 —— 项目可能在 ROS1 / ROS2 间切换，需保留
# ============================================================
devel/
logs/
build/
bin/
lib/
msg_gen/
srv_gen/
msg/*Action.msg
msg/*ActionFeedback.msg
msg/*ActionGoal.msg
msg/*ActionResult.msg
msg/*Feedback.msg
msg/*Goal.msg
msg/*Result.msg
msg/_*.py
build_isolated/
devel_isolated/

# Generated by dynamic reconfigure
*.cfgc
/cfg/cpp/
/cfg/*.py

# Ignore generated docs
*.dox
*.wikidoc

# eclipse stuff
.project
.cproject

# qcreator stuff
CMakeLists.txt.user

srv/_*.py
*.pcd
*.pyc
qtcreator-*
*.user

/planning/cfg
/planning/docs
/planning/src

*~

# Emacs
.#*

# Catkin custom files
CATKIN_IGNORE

# ============================================================
# ROS 2 (colcon) 构建产物
# colcon 会在工作区根目录生成 build/、install/、log/
# 注意：不加前导斜杠，可同时匹配任意子目录（如 src/build 等误产物）
# ============================================================
**/build/
**/install/
**/log/
**/build_isolated/
**/devel_isolated/
**/devel/
COLCON_IGNORE

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.pyd

# ============================================================
# ROS 2 数据与消息生成文件
# ============================================================
*.bag
*.bag.active
*.db3
*.db3-journal

# ============================================================
# 编辑器 / IDE
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.*.sw[a-z]

# ============================================================
# 系统 / 临时文件
# ============================================================
.DS_Store
Thumbs.db
*.tmp
*.bak

# ============================================================
# Jekyll / GitHub Pages（docs 子站）
# ============================================================
docs/_site/
docs/.jekyll-cache/
docs/.sass-cache/
docs/.jekyll-metadata
docs/vendor/
docs/.bundle/

# Ruby / Bundler
.bundle/
vendor/bundle/

# Node（如果后续使用）
node_modules/
